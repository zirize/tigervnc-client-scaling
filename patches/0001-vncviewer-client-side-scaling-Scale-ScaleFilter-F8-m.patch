+rfb::Point Viewport::toFramebuffer(int ex, int ey)
+{
+  Point pos;
+
+  pos.x = ex - x();
+  pos.y = ey - y();
+
+  if (!isScaling())
+    return pos;
+
+  // Same pixel centre convention as the renderer
+  pos.x = (int)floor((pos.x + 0.5 - imageRect.tl.x) / scaleX);
+  pos.y = (int)floor((pos.y + 0.5 - imageRect.tl.y) / scaleY);
+
+  pos.x = __rfbmax(0, __rfbmin(pos.x, fbWidth() - 1));
+  pos.y = __rfbmax(0, __rfbmin(pos.y, fbHeight() - 1));
+
+  return pos;
+}
+
+
+rfb::Point Viewport::fromFramebuffer(const rfb::Point& pos)
+{
+  if (!isScaling())
+    return Point(pos.x + x(), pos.y + y());
+
+  return Point(x() + imageRect.tl.x + (int)floor((pos.x + 0.5) * scaleX),
+               y() + imageRect.tl.y + (int)floor((pos.y + 0.5) * scaleY));
 }
 
 
