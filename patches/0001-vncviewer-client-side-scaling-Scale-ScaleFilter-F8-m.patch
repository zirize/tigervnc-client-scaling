+void Viewport::updateScale()
+{
+  ScaleMode newScaling;
+  ScaleFilter newFilter;
+  int fbW, fbH, dw, dh;
+
+  if (strcasecmp(scaleMode, "fit") == 0)
+    newScaling = SCALE_FIT;
+  else if (strcasecmp(scaleMode, "stretch") == 0)
+    newScaling = SCALE_STRETCH;
+  else if (strcasecmp(scaleMode, "integer") == 0)
+    newScaling = SCALE_INTEGER;
+  else {
+    if (strcasecmp(scaleMode, "off") != 0)
+      vlog.error("Unknown Scale \"%s\", using Off",
+                 (const char*)scaleMode);
+    newScaling = SCALE_OFF;
   }
 
-  Fl_Widget::resize(x, y, w, h);
+  if (strcasecmp(scaleFilter, "nearest") == 0)
+    newFilter = FILTER_NEAREST;
+  else if (strcasecmp(scaleFilter, "integerplus") == 0)
+    newFilter = FILTER_INTEGERPLUS;
+  else {
+    if (strcasecmp(scaleFilter, "linear") != 0)
+      vlog.error("Unknown ScaleFilter \"%s\", using Linear",
+                 (const char*)scaleFilter);
+    newFilter = FILTER_LINEAR;
+  }
+
+  // The intermediate copy is not maintained in other modes
+  if ((newScaling != scaling) || (newFilter != filter))
+    intermediateStale = true;
+  if (newScaling == SCALE_OFF)
+    intermediateDamage.clear();
+
+  scaling = newScaling;
+  filter = newFilter;
+
+  fbW = fbWidth();
+  fbH = fbHeight();
+
+  switch (scaling) {
+  case SCALE_STRETCH:
+    scaleX = (double)w() / fbW;
+    scaleY = (double)h() / fbH;
+    dw = w();
+    dh = h();
+    break;
+  case SCALE_INTEGER:
+    scaleX = floor(__rfbmin((double)w() / fbW, (double)h() / fbH));
+    if (scaleX >= 1.0) {
+      scaleY = scaleX;
+      dw = fbW * (int)scaleX;
+      dh = fbH * (int)scaleY;
+      break;
+    }
+    // Window smaller than the remote: shrink to fit
+    // fall through
+  case SCALE_FIT:
+    scaleX = __rfbmin((double)w() / fbW, (double)h() / fbH);
+    scaleY = scaleX;
+    dw = (int)lround(fbW * scaleX);
+    dh = (int)lround(fbH * scaleY);
+    break;
+  default:
+    scaleX = scaleY = 1.0;
+    dw = fbW;
+    dh = fbH;
+    break;
+  }
+
+  if (scaling == SCALE_OFF)
+    imageRect.setXYWH(0, 0, dw, dh);
+  else
+    imageRect.setXYWH((w() - dw) / 2, (h() - dh) / 2, dw, dh);
+}
