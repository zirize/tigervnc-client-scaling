+// fltk_menu_add() escapes '/', so it cannot add to a submenu
+static void fltk_submenu_add(Fl_Menu_ *menu, const char *parent,
+                             const char *text, void *data, int flags)
+{
+  char p[256], t[256], buffer[1024];
+
+  if (fltk_menu_escape(parent, p, sizeof(p)) >= sizeof(p))
+    return;
+  if (fltk_menu_escape(text, t, sizeof(t)) >= sizeof(t))
+    return;
+
+  snprintf(buffer, sizeof(buffer), "%s/%s", p, t);
+  menu->add(buffer, 0, nullptr, data, flags);
+}
