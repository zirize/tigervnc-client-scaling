+void Viewport::drawScaled(Surface* dst, int X, int Y, int W, int H)
+{
+  Rect clip, image;
+  int nx, ny;
+
+  // The letterbox around the image is the window background
+  image = imageRect.translate(Point(x(), y()));
+  clip.setXYWH(X, Y, W, H);
+  clip = clip.intersect(image);
+  if (clip.is_empty())
+    return;
+
+  if ((scaleX == 1.0) && (scaleY == 1.0)) {
+    intermediateStale = true;
+    frameBuffer->draw(dst, clip.tl.x - image.tl.x, clip.tl.y - image.tl.y,
+                      clip.tl.x, clip.tl.y, clip.width(), clip.height());
+    return;
+  }
+
+  nx = (int)floor(scaleX);
+  ny = (int)floor(scaleY);
+
+  // Integer mode is nearest by definition. IntegerPlus degrades to
+  // nearest at exact integer factors and to linear when shrinking.
+  if ((scaling == SCALE_INTEGER) || (filter != FILTER_INTEGERPLUS) ||
+      (nx < 1) || (ny < 1) || ((nx == scaleX) && (ny == scaleY))) {
+    bool smooth;
+
+    if ((scaling == SCALE_INTEGER) || (filter == FILTER_INTEGERPLUS))
+      smooth = (nx < 1) || (ny < 1);
+    else
+      smooth = filter == FILTER_LINEAR;
+
+    intermediateStale = true;
+    frameBuffer->drawScaled(dst, scaleX, scaleY, image.tl.x, image.tl.y,
+                            clip.tl.x, clip.tl.y,
+                            clip.width(), clip.height(), smooth);
+    return;
+  }
+
+  // IntegerPlus: nearest to an integer multiple, then linear for the
+  // rest. The intermediate copy is kept up to date from framebuffer
+  // damage, so the second pass may sample anywhere in it.
+
+  if ((intermediate == nullptr) || (intermediateX != nx) ||
+      (intermediateY != ny) ||
+      (intermediate->width() != fbWidth() * nx) ||
+      (intermediate->height() != fbHeight() * ny)) {
+    delete intermediate;
+    intermediate = new Surface(fbWidth() * nx, fbHeight() * ny);
+    intermediateX = nx;
+    intermediateY = ny;
+    intermediateStale = true;
+  }
+
+  if (intermediateStale) {
+    intermediateDamage.clear();
+    intermediateDamage.assign_union(rfb::Region(frameBuffer->getRect()));
+    intermediateStale = false;
+  }
+
+  if (!intermediateDamage.is_empty()) {
+    std::vector<Rect> rects;
+
+    intermediateDamage.get_rects(&rects);
+    for (const Rect& r : rects) {
+      frameBuffer->drawScaled(intermediate, nx, ny, 0, 0,
+                              r.tl.x * nx, r.tl.y * ny,
+                              r.width() * nx, r.height() * ny, false);
+    }
+    intermediateDamage.clear();
+  }
+
+  intermediate->drawScaled(dst, scaleX / nx, scaleY / ny,
+                           image.tl.x, image.tl.y,
+                           clip.tl.x, clip.tl.y,
+                           clip.width(), clip.height(), true);
+}
