+void Surface::drawScaled(Surface* dst, double sx, double sy,
+                         int org_x, int org_y, int dst_x, int dst_y,
+                         int dst_w, int dst_h, bool smooth)
+{
+  XTransform scale = {{
+    { XDoubleToFixed(1.0 / sx), 0, 0 },
+    { 0, XDoubleToFixed(1.0 / sy), 0 },
+    { 0, 0, XDoubleToFixed(1.0) }
+  }};
+  XTransform identity = {{
+    { XDoubleToFixed(1.0), 0, 0 },
+    { 0, XDoubleToFixed(1.0), 0 },
+    { 0, 0, XDoubleToFixed(1.0) }
+  }};
+  XRenderPictureAttributes attr;
+
+  XRenderSetPictureTransform(fl_display, picture, &scale);
+  XRenderSetPictureFilter(fl_display, picture,
+                          smooth ? FilterBilinear : FilterNearest,
+                          nullptr, 0);
+  // Without padding, bilinear sampling fades into transparent black
+  // along the right and bottom edges
+  attr.repeat = RepeatPad;
+  XRenderChangePicture(fl_display, picture, CPRepeat, &attr);
+
+  XRenderComposite(fl_display, PictOpSrc, picture, None, dst->picture,
+                   dst_x - org_x, dst_y - org_y, 0, 0,
+                   dst_x, dst_y, dst_w, dst_h);
+
+  // Other users of this picture expect a plain 1:1 copy
+  XRenderSetPictureTransform(fl_display, picture, &identity);
+  XRenderSetPictureFilter(fl_display, picture, FilterNearest, nullptr, 0);
+  attr.repeat = RepeatNone;
+  XRenderChangePicture(fl_display, picture, CPRepeat, &attr);
+}
