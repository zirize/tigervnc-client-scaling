+core::Point Viewport::toFramebuffer(int ex, int ey)
+{
+  core::Point pos;
+
+  pos.x = ex - x();
+  pos.y = ey - y();
+
+  if (!isScaling())
+    return pos;
+
+  // Same pixel centre convention as the renderer
+  pos.x = (int)floor((pos.x + 0.5 - imageRect.tl.x) / scaleX);
+  pos.y = (int)floor((pos.y + 0.5 - imageRect.tl.y) / scaleY);
+
+  pos.x = std::max(0, std::min(pos.x, fbWidth() - 1));
+  pos.y = std::max(0, std::min(pos.y, fbHeight() - 1));
+
+  return pos;
+}
+
+
+core::Point Viewport::fromFramebuffer(const core::Point& pos)
+{
+  if (!isScaling())
+    return core::Point(pos.x + x(), pos.y + y());
+
+  return core::Point(x() + imageRect.tl.x + (int)floor((pos.x + 0.5) * scaleX),
+               y() + imageRect.tl.y + (int)floor((pos.y + 0.5) * scaleY));
 }
 
 
