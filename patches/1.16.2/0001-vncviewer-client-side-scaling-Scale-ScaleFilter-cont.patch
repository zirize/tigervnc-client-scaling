+void Viewport::updateScale()
+{
+  ScaleMode newScaling;
+  ScaleFilter newFilter;
+  int fbW, fbH, dw, dh;
+
+  // EnumParameter has already rejected invalid values and compares
+  // without case
+  if (scaleMode == "Fit")
+    newScaling = SCALE_FIT;
+  else if (scaleMode == "Stretch")
+    newScaling = SCALE_STRETCH;
+  else if (scaleMode == "Integer")
+    newScaling = SCALE_INTEGER;
+  else
+    newScaling = SCALE_OFF;
+
+  if (scaleFilter == "Nearest")
+    newFilter = FILTER_NEAREST;
+  else if (scaleFilter == "IntegerPlus")
+    newFilter = FILTER_INTEGERPLUS;
+  else
+    newFilter = FILTER_LINEAR;
+
+  // The intermediate copy is not maintained in other modes
+  if ((newScaling != scaling) || (newFilter != filter))
+    intermediateStale = true;
+  if (newScaling == SCALE_OFF)
+    intermediateDamage.clear();
+
+  scaling = newScaling;
+  filter = newFilter;
+
+  fbW = fbWidth();
+  fbH = fbHeight();
+
+  switch (scaling) {
+  case SCALE_STRETCH:
+    scaleX = (double)w() / fbW;
+    scaleY = (double)h() / fbH;
+    dw = w();
+    dh = h();
+    break;
+  case SCALE_INTEGER:
+    scaleX = floor(std::min((double)w() / fbW, (double)h() / fbH));
+    if (scaleX >= 1.0) {
+      scaleY = scaleX;
+      dw = fbW * (int)scaleX;
+      dh = fbH * (int)scaleY;
+      break;
+    }
+    // Window smaller than the remote: shrink to fit
+    // fall through
+  case SCALE_FIT:
+    scaleX = std::min((double)w() / fbW, (double)h() / fbH);
+    scaleY = scaleX;
+    dw = (int)lround(fbW * scaleX);
+    dh = (int)lround(fbH * scaleY);
+    break;
+  default:
+    scaleX = scaleY = 1.0;
+    dw = fbW;
+    dh = fbH;
+    break;
   }
 
-  Fl_Widget::resize(x, y, w, h);
+  if (scaling == SCALE_OFF)
+    imageRect.setXYWH(0, 0, dw, dh);
+  else
+    imageRect.setXYWH((w() - dw) / 2, (h() - dh) / 2, dw, dh);
+}
